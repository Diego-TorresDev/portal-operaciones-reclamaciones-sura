
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot administra las versiones compatibles de las dependencias. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <!-- Identificación del proyecto dentro del ecosistema Maven. -->
    <groupId>com.sura</groupId>
    <artifactId>portal-reclamaciones</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>portal-reclamaciones</name>
    <description>Portal de Operaciones de Reclamaciones de Salud</description>

    <!-- Todo el proyecto se compila con Java 17. -->
    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!--
            CAPA DE DATOS

            JPA permite representar las tablas como clases Java y acceder
            a PostgreSQL mediante entidades y repositorios.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Controla validaciones de los datos recibidos por la API. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Driver JDBC necesario para conectarse a PostgreSQL. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>


        <!--
            SERVIDOR Y API

            WebFlux utiliza programación reactiva y Netty como servidor
            integrado, evitando incorporar el servidor Tomcat tradicional.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>


        <!--
            SEGURIDAD

            Spring Security protege los endpoints y administra las reglas
            de acceso. El Resource Server permite validar los JWT enviados
            por el cliente mediante la cabecera Authorization: Bearer.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>


        <!--
            MIGRACIONES DE BASE DE DATOS

            Este starter integra Flyway con Spring Boot para detectar
            y ejecutar automáticamente las migraciones pendientes.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <!--
            Flyway necesita este módulo adicional para interpretar y
            ejecutar correctamente las migraciones destinadas a PostgreSQL.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>


        <!--
            PRUEBAS AUTOMATIZADAS

            Estas dependencias proporcionan herramientas para probar JPA,
            validaciones y endpoints WebFlux sin depender solo de pruebas
            manuales desde Postman.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>

		<!-- Apache POI se encarga de leer los archivos Excel .xlsx de la prueba. -->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.5.1</version>
		</dependency>

		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
			<version>3.2.0</version>
		</dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Permite iniciar y empaquetar la aplicación Spring Boot. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
